# Required to send the contact form. Use the value dev locally to
# show the success state without calling Resend.
RESEND_API_KEY=
# Defaults to khaled@basilplast.md when omitted.
CONTACT_TO=khaled@basilplast.md
# Verified sender, for example: BASIL PLAST <website@basilplast.md>
CONTACT_FROM=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
